# Copia este archivo como .env.local (no se sube a git).

# Contraseña del panel admin. En desarrollo es opcional: sin ella se entra sin login.
VITE_ADMIN_PASSWORD=

# Pon "true" solo si quieres el panel admin en un build web de producción
# (además exige VITE_ADMIN_PASSWORD). Nunca se incluye en la APK.
VITE_ENABLE_ADMIN=false
